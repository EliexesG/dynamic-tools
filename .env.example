# A&M Dynamic Tools — environment template
# Copy to .env (or .env.local) and fill in real values. Never commit real secrets.

# --- Core app ---
# Base URL of the deployed site. Used by src/app/layout.jsx (metadataBase),
# src/app/sitemap.js and src/app/robots.js. REQUIRED: a fresh install crashes
# at build/boot with "Invalid URL" if this is unset (new URL(undefined)).
# Example: https://dynamictoolscr.com
URL_BASE=

# Google Search Console verification token (src/app/layout.jsx > metadata.verification).
# Optional; omit the line if unused.
GOOGLE_VERIFICATION=

# --- Contact form email (src/config/nodemailer.js + src/app/api/contacto/route.js) ---
# SMTP credentials used by Nodemailer. The legacy USER / PASS names were renamed
# to the explicit SMTP_* names because USER collides with the POSIX shell var.
SMTP_USER=
SMTP_PASS=

# SMTP transport service. Defaults to "gmail" when unset.
SMTP_SERVICE=gmail

# Placeholder guidance (do not put real values in this file):
#   SMTP_USER  = the sending Gmail account, e.g. dynamictoolscr@gmail.com
#   SMTP_PASS  = Gmail App Password (16 chars), not the account password

# --- Mail addresses (currently hardcoded in src/config/nodemailer.js; to be moved here) ---
#   Contact recipient (company inbox): dynamictoolscr@gmail.com
#   CC reviewer:                      jalfarodynamictools@gmail.com
#   Auto-reply "from":                dynamictoolscr@gmail.com
CONTACT_RECIPIENT_EMAIL=
CONTACT_CC_EMAIL=
CONTACT_FROM_EMAIL=
